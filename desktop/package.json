{
  "name": "medha-windows",
  "productName": "Medha",
  "version": "1.0.0",
  "description": "Offline-First Cognitive Retention Engine & Spatial PKM for Windows",
  "main": "electron/main.js",
  "scripts": {
    "build:renderer": "esbuild src/js/modules.js --bundle --format=iife --global-name=__MedhaModulesBundle --outfile=src/js/bundle.js",
    "typecheck": "tsc --noEmit",
    "start": "npm run build:renderer && electron electron/main.js",
    "test": "node tests/runner.js",
    "test:db": "node tests/database.test.js",
    "test:fsrs": "node tests/fsrs.test.js",
    "test:ipc": "node tests/ipc.test.js",
    "test:flashcards": "node tests/flashcards.test.js",
    "test:pkm": "node tests/pkm.test.js",
    "test:editor": "node tests/editor.test.js",
    "test:ink": "node tests/ink.test.js",
    "test:palace": "node tests/palace.test.js",
    "test:graph": "node tests/graph.test.js",
    "test:ai": "node tests/ai.test.js",
    "test:import-export": "node tests/ankiImporter.test.js",
    "test:smoke": "npm run build:renderer && node tests/smoke.js",
    "dist:win": "npm run build:renderer && electron-builder --win nsis portable --x64"
  },
  "keywords": [
    "pkm",
    "fsrs",
    "flashcards",
    "memory-palace",
    "knowledge-graph",
    "ink-notes"
  ],
  "author": "Medha Team",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "fzstd": "^0.1.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.medha.desktop",
    "productName": "Medha",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
