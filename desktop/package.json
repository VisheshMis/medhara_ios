{
  "name": "medha-windows",
  "productName": "Medha",
  "version": "1.0.0",
  "description": "Offline-First Cognitive Retention Engine & Spatial PKM for Windows",
  "main": "electron/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build:renderer && electron electron/main.js",
    "test": "node tests/runner.js && node tests/v2_features.test.js && node tests/notion_engine.test.js",
    "test:notion": "node tests/notion_engine.test.js",
    "test:v2": "node tests/v2_features.test.js",
    "test:db": "node tests/database.test.js",
    "test:fsrs": "node tests/fsrs.test.js",
    "test:ipc": "node tests/ipc.test.js",
    "test:flashcards": "node tests/flashcards.test.js",
    "test:pkm": "node tests/pkm.test.js",
    "test:editor": "node tests/editor.test.js",
    "test:ink": "node tests/ink.test.js",
    "test:palace": "node tests/palace.test.js",
    "test:graph": "node tests/graph.test.js",
    "test:ai": "node tests/ai.test.js",
    "test:import-export": "node tests/ankiImporter.test.js",
    "test:smoke": "npm run build:renderer && node tests/smoke.js",
    "dist:win": "npm run build:renderer && electron-builder --win nsis portable --x64 -c.npmRebuild=false"
  },
  "keywords": [
    "pkm",
    "fsrs",
    "flashcards",
    "memory-palace",
    "knowledge-graph",
    "ink-notes"
  ],
  "author": "Medha Team",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.medha.desktop",
    "productName": "Medha",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  }
}
